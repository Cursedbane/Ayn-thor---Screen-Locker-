    <string name="app_name">Thor Lock</string>
    <string name="a11y_desc">Thor Lock shows a lock screen after the lid is closed and accepts the password via gamepad buttons. Accessibility is needed so protection keeps working even when the app is closed. The app does not read screen content and sends nothing to the internet.</string>
